# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/

# This project must never ship game files or personal data.
# Keep them out of the repository even if they are copied here by accident.
*.exe
*.dll
*.upk
*.umap
*.tfc
*.bak
*.pdb
XComGame/

# XCOM 2 save files carry no extension and are written as "save_<desc>".
# Anchor the pattern so it cannot swallow sources such as docs/SAVE_FORMAT.md
# on case-insensitive filesystems (Windows, macOS).
/save_*
save_[!A-Za-z]*

# Editors / OS
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini
